<mxfile host="app.diagrams.net" type="device"><diagram name="Face enrolment workflow" id="face-enrolment-workflow"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Face enrolment workflow (PTZ concept)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1B2730;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1380" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Done only on the dedicated college phone, under college staff supervision. Photos go through our office only. The central system supplies the student list but never receives photos or face data." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B6B75;align=left;verticalAlign=middle;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="40" y="55" width="1380" height="25" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#9AA8AE;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="1380" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;College central system&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="50" y="100" width="160" height="150" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF8E6;fontColor=#1B2730;strokeColor=#9AA8AE;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="260" width="1380" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Enrolment desk: student + supervising college staff&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="50" y="260" width="160" height="150" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#9AA8AE;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="420" width="1380" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Our office (Enrolment Converter)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="50" y="420" width="160" height="150" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#9AA8AE;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="580" width="1380" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Edge AI server (college)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="50" y="580" width="160" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;0.&lt;/b&gt; Sends the college student list (ID, name, class, RF card)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="222" y="117" width="138" height="116" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;1.&lt;/b&gt; Staff logs in on the college phone (staff ID + PIN / OTP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="222" y="277" width="138" height="116" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;2.&lt;/b&gt; Student shows college ID card; staff checks face, records consent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="372" y="277" width="138" height="116" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;3.&lt;/b&gt; Guided capture: 5 angles, liveness, ring light, tripod" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="522" y="277" width="138" height="116" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;4.&lt;/b&gt; Encrypt and send from the registered phone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="672" y="277" width="138" height="116" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;5.&lt;/b&gt; Decrypt; check phone, staff and student ID" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="672" y="437" width="138" height="116" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;6.&lt;/b&gt; Quality check each photo (size, sharpness, light, pose)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="822" y="437" width="138" height="116" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;7.&lt;/b&gt; Convert: align, crop 112 x 112, build face templates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="972" y="437" width="138" height="116" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;8.&lt;/b&gt; Checks: ID in college list, no duplicate face, same face if re-enrolled" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="972" y="597" width="138" height="116" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;9.&lt;/b&gt; Store in face database; receipt to office" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1122" y="597" width="138" height="116" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;10.&lt;/b&gt; Receipt: wipe local photos, audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1122" y="437" width="138" height="116" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;11.&lt;/b&gt; Encrypted backup (2 copies) within minutes; ready to scan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1272" y="597" width="138" height="116" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="secure upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="VPN push (signed batch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="fails: retake" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#B5452F;align=left;verticalAlign=middle;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="800" y="400" width="120" height="16" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c19" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="891" y="415"/><mxPoint x="591" y="415"/></Array></mxGeometry></mxCell><mxCell id="c37" value="student list (API)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#0E7C86;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0E7C86;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1438" y="175"/><mxPoint x="1438" y="590"/><mxPoint x="1082" y="590"/></Array></mxGeometry></mxCell><mxCell id="c38" value="refused: reason to office" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c21" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="741" y="655"/></Array></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Enrolment camera (recommended): Samsung Galaxy A36 5G or equivalent&lt;/b&gt;&lt;br&gt;50 MP main camera, OIS, f/1.8 autofocus; capture at 12 MP; Android 14+ with Android Enterprise / Knox kiosk mode; 8 GB RAM; registered device ID. Accessories: 10-inch LED ring light (about 500 lux on the face), tripod at eye level 1.0 to 1.2 m, plain light-grey backdrop. Gives a face of 600+ pixels." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=left;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="750" width="680" height="130" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Guards against misuse&lt;/b&gt;&lt;br&gt;Students never enrol on their own phones. Only registered college phones and logged-in staff can send photos. The staff ID, device and time of every enrolment are audited. A face already enrolled under another ID is refused; re-enrolling a student with a different face is refused unless two staff first delete the old enrolment." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=left;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="740" y="750" width="680" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net" type="device"><diagram name="Face enrolment workflow" id="face-enrolment-workflow"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Face enrolment workflow (PTZ concept)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1B2730;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Photos go through our office only. The college central system takes no part in enrolment." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B6B75;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1300" height="25" as="geometry"/></mxCell><mxCell id="c5" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF8E6;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1320" height="170" as="geometry"/></mxCell><mxCell id="c6" value="Student (phone app)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="100" width="170" height="170" as="geometry"/></mxCell><mxCell id="c7" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#D3EAEC;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1320" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Our office (Enrolment Converter)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="170" height="170" as="geometry"/></mxCell><mxCell id="c9" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1320" height="170" as="geometry"/></mxCell><mxCell id="c10" value="Edge AI server (college)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#0F3B44;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="460" width="170" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1.&lt;/b&gt; Log in with OTP and give consent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="128" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;2.&lt;/b&gt; Capture 5 angles with liveness check" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="128" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;3.&lt;/b&gt; Encrypt and send to our office" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="510" y="130" width="128" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;4.&lt;/b&gt; Receive, decrypt, match ID to roster" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="650" y="310" width="128" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;5.&lt;/b&gt; Quality check each photo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="790" y="310" width="128" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;6.&lt;/b&gt; Convert: align, crop, build face templates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0E7C86;fontColor=#FFFFFF;strokeColor=#0E7C86;" vertex="1" parent="1"><mxGeometry x="930" y="310" width="128" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;7.&lt;/b&gt; Check model version, store in face database" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#FFFFFF;strokeColor=#0F3B44;" vertex="1" parent="1"><mxGeometry x="1070" y="490" width="128" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;8.&lt;/b&gt; Receipt received: wipe local photos, audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;" vertex="1" parent="1"><mxGeometry x="1070" y="310" width="128" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;9.&lt;/b&gt; Student enrolled and ready to scan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#5E8C3A;fontColor=#FFFFFF;strokeColor=#5E8C3A;" vertex="1" parent="1"><mxGeometry x="1210" y="490" width="128" height="110" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="secure upload / e-mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="fails: retake request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="265"/><mxPoint x="445" y="265"/></Array></mxGeometry></mxCell><mxCell id="c26" value="VPN push (signed batch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#0E7C86;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0E7C86;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;College central system:&lt;/b&gt; takes no part in enrolment and never receives photos, face images or templates." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#B5452F;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1320" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxCell id="c17" value="B. Recognition on the edge AI unit (every scan window of a lecture)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1180" height="330" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;6 cameras per hall&lt;/b&gt;&lt;br&gt;8 MP PoE, RTSP streams" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="355" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Decode&lt;/b&gt;&lt;br&gt;GStreamer + NVIDIA NVDEC hardware decoder" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="355" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Tiling&lt;/b&gt;&lt;br&gt;8 MP frame cut into overlapping tiles so back-row faces keep full resolution" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="355" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Face detection&lt;/b&gt;&lt;br&gt;YuNet on TensorRT FP16; merge tiles with NMS" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="355" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Tracking&lt;/b&gt;&lt;br&gt;ByteTrack (MIT): one track ID per student across frames" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="355" width="215" height="95" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;Quality gate&lt;/b&gt;&lt;br&gt;≥60 px between eyes, sharpness, near-frontal pose" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="505" width="215" height="95" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;Align + embed&lt;/b&gt;&lt;br&gt;SFace on TensorRT FP16; normalised vector" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="505" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;Match&lt;/b&gt;&lt;br&gt;FAISS cosine search; threshold + margin over 2nd best" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="505" width="195" height="95" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Multi-scan voting&lt;/b&gt;&lt;br&gt;Present only after N consistent matches; conflicts flagged" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="505" width="195" height="95" as="geometry"/></mxCell>

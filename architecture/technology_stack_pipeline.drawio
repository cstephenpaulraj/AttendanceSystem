<mxCell id="c47" value="D. Technology stack on each edge AI unit" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="75" width="430" height="745" as="geometry"/></mxCell>
<mxCell id="c48" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;Python 3 · FastAPI · SQLite · Docker (L4T base image)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="115" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;AI models (ONNX, swappable)&lt;/b&gt;&lt;br&gt;YuNet detector (MIT) · SFace recogniser (Apache-2.0) · Silent-Face liveness (Apache-2.0)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="207" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c50" value="&lt;b&gt;Vision and search libraries&lt;/b&gt;&lt;br&gt;OpenCV (Apache-2.0) · FAISS (MIT) · ByteTrack (MIT) · NumPy" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="299" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;Inference runtime&lt;/b&gt;&lt;br&gt;TensorRT FP16 on Jetson · ONNX Runtime on development PCs · CUDA / cuDNN" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="391" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;Video pipeline&lt;/b&gt;&lt;br&gt;GStreamer · NVDEC hardware decode · DeepStream optional" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="483" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;Operating system&lt;/b&gt;&lt;br&gt;NVIDIA JetPack (Ubuntu-based L4T)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="575" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c54" value="&lt;b&gt;Hardware&lt;/b&gt;&lt;br&gt;Jetson Orin class edge AI unit, 1 per hall, 6 cameras each" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="667" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="c55" value="E. Upgrade path (decision gate after the pilot)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="820" height="190" as="geometry"/></mxCell>
<mxCell id="c56" value="If YuNet + SFace cannot meet the agreed accuracy targets after tuning, replace ONLY the failing stage; the rest of the pipeline is unchanged because every model sits behind an ONNX interface.&lt;br&gt;• Detector → commercially licensed SCRFD or RetinaFace weights&lt;br&gt;• Recogniser → InsightFace ArcFace models under a paid commercial licence&lt;br&gt;• Whole engine → commercial SDK (e.g. CyberLink FaceMe, Paravision, Neurotechnology)" style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="875" width="790" height="150" as="geometry"/></mxCell>

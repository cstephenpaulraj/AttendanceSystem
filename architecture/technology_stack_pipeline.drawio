<mxfile host="app.diagrams.net" type="device">
  <diagram id="tech-stack-pipeline" name="Technology stack and pipeline">
    <mxGraphModel dx="1700" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;AI-Driven Classroom Attendance System: Edge AI Software Technology Stack and Pipeline&lt;/b&gt;&lt;br&gt;Fixed-camera solution, one edge AI unit per lecture hall (5 halls). Companion to docs/Technology_Selection_Strategy.md" style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="A. Enrolment (once per student, at the enrolment station)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1180" height="200" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Consent + capture&lt;/b&gt;&lt;br&gt;DPDP Act 2023 consent; 5 to 10 images, several poses" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Face detection&lt;/b&gt;&lt;br&gt;OpenCV YuNet&lt;br&gt;(MIT)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="225" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Quality + liveness&lt;/b&gt;&lt;br&gt;Size, blur, pose; Silent-Face anti-spoof (Apache-2.0)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Align + embed&lt;/b&gt;&lt;br&gt;5-point alignment to 112×112; OpenCV SFace (Apache-2.0)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="555" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Duplicate check&lt;/b&gt;&lt;br&gt;FAISS search against existing gallery (MIT)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Encrypted gallery&lt;/b&gt;&lt;br&gt;Embeddings by roll number, AES-256" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="885" y="130" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Sync to all 5 edge units&lt;/b&gt;&lt;br&gt;Students can attend any hall" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="130" width="150" height="90" as="geometry"/></mxCell>

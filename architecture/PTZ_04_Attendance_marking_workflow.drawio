<mxfile host="app.diagrams.net" type="device"><diagram name="Attendance marking workflow" id="attendance-marking-workflow"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Attendance marking workflow with the PTZ cameras" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1B2730;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Per hall, per lecture. About 2 min 10 s for pass 1 and about 2 min 47 s with revisits; all halls scan in parallel." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B6B75;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1300" height="25" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;timetable or faculty Scan button (no tone)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#FFFFFF;strokeColor=#0F3B44;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="215" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Primary camera healthy?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;" vertex="1" parent="1"><mxGeometry x="305" y="105" width="215" height="105" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Home check&lt;/b&gt;&lt;br&gt;fixed target, re-home on drift" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="215" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Pass 1&lt;/b&gt;&lt;br&gt;75 points: move to stored pan / tilt / zoom, set focus, capture 3 frames" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0E7C86;fontColor=#FFFFFF;strokeColor=#0E7C86;" vertex="1" parent="1"><mxGeometry x="835" y="110" width="215" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Recognise on GPU&lt;/b&gt;&lt;br&gt;detect, quality, match to class roster" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0E7C86;fontColor=#FFFFFF;strokeColor=#0E7C86;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="215" height="95" as="geometry"/></mxCell><mxCell id="c10" value="Standby camera runs the same sequence (its own taught points)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="185" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;All expected faces matched?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;" vertex="1" parent="1"><mxGeometry x="1100" y="335" width="215" height="105" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Revisit pass&lt;/b&gt;&lt;br&gt;tighter zoom (2 students), retry after 20 to 30 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#FFFFFF;strokeColor=#0F3B44;" vertex="1" parent="1"><mxGeometry x="835" y="340" width="215" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Matched now?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;" vertex="1" parent="1"><mxGeometry x="570" y="335" width="215" height="105" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Faculty review list&lt;/b&gt;&lt;br&gt;one-tap confirm or absent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#F6E3DF;" vertex="1" parent="1"><mxGeometry x="305" y="340" width="215" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Both cameras down&lt;/b&gt;&lt;br&gt;manual roll call, marked manual" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="215" height="95" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20"
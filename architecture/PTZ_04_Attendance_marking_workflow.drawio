<mxfile host="app.diagrams.net" type="device"><diagram name="Attendance marking workflow" id="attendance-marking-workflow"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Attendance marking workflow with the PTZ cameras" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1B2730;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1380" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Per hall, per lecture session sent by the central system. About 2 min 10 s for pass 1 and about 2 min 47 s with revisits; all halls scan in parallel." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B6B75;align=left;verticalAlign=middle;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="40" y="55" width="1380" height="25" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Session from the central system&lt;/b&gt;&lt;br&gt;subject, lecturer, hall, time, students expected" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#FFFFFF;strokeColor=#0F3B44;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;at the session time or the lecturer's Scan button (no tone)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#FFFFFF;strokeColor=#0F3B44;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="280" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Primary camera healthy?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="520" y="100" width="200" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Home check&lt;/b&gt;&lt;br&gt;fixed target, re-home on drift" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="760" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Pass 1&lt;/b&gt;&lt;br&gt;75 points: stored pan / tilt / zoom, focus, 3 frames" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1000" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Recognise on GPU&lt;/b&gt;&lt;br&gt;detect, quality, match to face database" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1240" y="110" width="190" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Standby camera healthy?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="520" y="260" width="200" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Standby camera runs the same sequence (its own taught points)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="760" y="270" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;RF reader fallback&lt;/b&gt;&lt;br&gt;both cameras down: students tap cards on the existing RF readers; marked RF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#F6E3DF;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="520" y="430" width="200" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;On the session's student list?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1240" y="260" width="190" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;NOT IN LIST&lt;/b&gt;&lt;br&gt;enrolled student seen but not sent by the central system: reported" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#F6E3DF;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1240" y="420" width="190" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;All expected students matched?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1000" y="260" width="200" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Revisit pass&lt;/b&gt;&lt;br&gt;tighter zoom (2 students), retry after 20 to 30 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1000" y="430" width="200" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Matched now?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFF4D6;fontColor=#1B2730;strokeColor=#FFF4D6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="760" y="420" width="200" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Lecturer review list&lt;/b&gt;&lt;br&gt;one-tap confirm or absent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F6E3DF;fontColor=#1B2730;strokeColor=#F6E3DF;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="760" y="580" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c12" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="yes: PRESENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Finalise, override and hand over" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#9AA8AE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#0F3B44;" parent="1" vertex="1"><mxGeometry x="40" y="720" width="1390" height="320" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Session result&lt;/b&gt;&lt;br&gt;PRESENT (face or RF), ABSENT (not seen), NOT IN LIST" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="770" width="250" height="110" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Saved on the edge database&lt;/b&gt;&lt;br&gt;with method, time, unknown-face count; audit log; backed up" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="340" y="770" width="250" height="110" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Lecturer override (within 2 days)&lt;/b&gt;&lt;br&gt;ON DUTY for paper presentation, sports or other official duty; reason required; audited" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F2A900;fontColor=#1B2730;strokeColor=#F2A900;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="620" y="770" width="280" height="110" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Central system pulls attendance&lt;/b&gt;&lt;br&gt;any time, by session ID (or date, subject, hall) via the API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0E7C86;fontColor=#FFFFFF;strokeColor=#0E7C86;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="930" y="770" width="250" height="110" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Kept on the edge until pulled&lt;/b&gt;&lt;br&gt;nothing lost if the network is down" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EEF2F3;fontColor=#1B2730;strokeColor=#EEF2F3;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1210" y="770" width="200" height="110" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" edge="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.88;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c16" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="315"/><mxPoint x="980" y="700"/><mxPoint x="280" y="700"/></Array></mxGeometry></mxCell><mxCell id="c46" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5E8C3A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5E8C3A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.76;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c18" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="480"/><mxPoint x="740" y="700"/><mxPoint x="250" y="700"/></Array></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.64;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c19" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="700"/><mxPoint x="220" y="700"/></Array></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.52;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c13" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="700"/><mxPoint x="190" y="700"/></Array></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c15" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="700"/><mxPoint x="160" y="700"/></Array></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;A face counts after it is matched in several frames. The RF readers are used only when both PTZ cameras have failed, and those marks are flagged RF. Only the session's lecturer can override, only for students on the session list, and only within 2 days of the session end; the original status is kept. Students who attend without being on the central system's list are reported as NOT IN LIST, so the central system learns about them. The central system can pull a session's attendance during or after the session, as many times as needed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=left;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="905" width="1350" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
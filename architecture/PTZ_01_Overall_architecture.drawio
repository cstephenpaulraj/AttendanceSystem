<mxfile host="app.diagrams.net" type="device"><diagram name="Overall architecture" id="overall-architecture"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="AI-Driven Classroom Attendance System: overall architecture (PTZ concept)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1B2730;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1540" height="40" as="geometry"/></mxCell><mxCell id="c4" value="One primary + one standby PTZ camera per hall, existing RF readers as fallback. Live face database only on the Edge AI server, with encrypted backups. The central system sends sessions and pulls attendance." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B6B75;align=left;verticalAlign=middle;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="40" y="55" width="1540" height="25" as="geometry"/></mxCell><mxCell id="c5" value="Enrolment (college desk + our office)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fillColor=#FFF8E6;strokeColor=#9AA8AE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#0F3B44;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="330" height="830" as="geometry"/></mxCell><mxCell id="c6" value="College campus: halls and server room" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fillColor=#EEF2F3;strokeColor=#9AA8AE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#0F3B44;" parent="1" vertex="1"><mxGeometry x="400" y="100" width="760" height="830" as="geometry"/></mxCell><mxCell id="c7" value="College systems" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fillColor=#F6E3DF;strokeColor=#9AA8AE;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#0F3B44;" parent="1" vertex="1"><mxGeometry x="1250" y="100" width="330" height="830" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Dedicated college enrolment phone&lt;/b&gt;&lt;br&gt;Kiosk app, college staff supervises:&lt;br&gt;staff login, ID card check, consent,&lt;br&gt;liveness, 5 guided photos, encrypted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="150" width="290" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Our office PC: Enrolment Converter&lt;/b&gt;&lt;br&gt;checks device + staff, quality, align 112 x 112,&lt;br&gt;face templates; wipes photos after receipt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0E7C86;fontColor=#FFFFFF;strokeColor=#0E7C86;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="370" width="290" height="130" as="geometry"/></mxCell><mxCell id="c10" value="encrypted upload&lt;br&gt;(registered phone only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Enrolment camera (recommended)&lt;/b&gt;&lt;br&gt;Samsung Galaxy A36 5G class: 50 MP rear camera with OIS, Android Enterprise kiosk;&lt;br&gt;ring light, tripod, plain backdrop" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="530" width="290" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Who may enrol&lt;/b&gt;&lt;br&gt;Only college staff logged in on a registered college phone. Students never use their own phones.&lt;br&gt;Every enrolment records the staff ID and device, and is checked against the college student list." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="60" y="690" width="290" height="210" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#0F3B44;fontColor=#1B2730;strokeColor=#0F3B44;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="830" y="140" width="300" height="590" as="geometry"/></mxCell><mxCell id="c14" value="Edge AI server" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#F2A900;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="830" y="145" width="300" height="32" as="geometry"/></mxCell><mxCell id="c15" value="Sequence engine + camera failover" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="185" width="270" height="58" as="geometry"/></mxCell><mxCell id="c16" value="Vision on GPU (detect, recognise)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="253" width="270" height="58" as="geometry"/></mxCell><mxCell id="c17" value="Session manager: sessions + student lists from central" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="321" width="270" height="58" as="geometry"/></mxCell><mxCell id="c18" value="Attendance engine: face / RF fallback / lecturer override (2 days)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="389" width="270" height="58" as="geometry"/></mxCell><mxCell id="c19" value="Face database (live copy, encrypted disk, RAID-1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F2A900;fontColor=#1B2730;strokeColor=#F2A900;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="457" width="270" height="58" as="geometry"/></mxCell><mxCell id="c20" value="Backup + integrity: encrypted copies, daily check, audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#F2A900;fontColor=#1B2730;strokeColor=#F2A900;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="525" width="270" height="58" as="geometry"/></mxCell><mxCell id="c21" value="APIs: sessions in, attendance out" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="593" width="270" height="58" as="geometry"/></mxCell><mxCell id="c22" value="Web UI: teach, monitor, override, reports" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#1F5560;fontColor=#FFFFFF;strokeColor=#1F5560;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="845" y="661" width="270" height="58" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Hall 1&lt;/b&gt;&lt;br&gt;Primary PTZ + Standby PTZ&lt;br&gt;&lt;font style='font-size:11px'&gt;Matrix SATATYA PTZ5040P&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Existing RF card reader&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="140" width="230" height="95" as="geometry"/></mxCell><mxCell id="c24" value="PoE++ switch (Cat6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#5B6B75;fontColor=#FFFFFF;strokeColor=#5B6B75;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="162" width="110" height="50" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=none;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" parent="1" edge="1" source="c24" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Hall 2&lt;/b&gt;&lt;br&gt;Primary PTZ + Standby PTZ&lt;br&gt;&lt;font style='font-size:11px'&gt;Matrix SATATYA PTZ5040P&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Existing RF card reader&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="260" width="230" height="95" as="geometry"/></mxCell><mxCell id="c28" value="PoE++ switch (Cat6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#5B6B75;fontColor=#FFFFFF;strokeColor=#5B6B75;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="282" width="110" height="50" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=none;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.21000000000000002;entryDx=0;entryDy=0;" parent="1" edge="1" source="c28" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Hall 3&lt;/b&gt;&lt;br&gt;Primary PTZ + Standby PTZ&lt;br&gt;&lt;font style='font-size:11px'&gt;Matrix SATATYA PTZ5040P&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Existing RF card reader&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="380" width="230" height="95" as="geometry"/></mxCell><mxCell id="c32" value="PoE++ switch (Cat6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#5B6B75;fontColor=#FFFFFF;strokeColor=#5B6B75;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="402" width="110" height="50" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=none;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.34;entryDx=0;entryDy=0;" parent="1" edge="1" source="c32" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Hall 4&lt;/b&gt;&lt;br&gt;Primary PTZ + Standby PTZ&lt;br&gt;&lt;font style='font-size:11px'&gt;Matrix SATATYA PTZ5040P&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Existing RF card reader&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="500" width="230" height="95" as="geometry"/></mxCell><mxCell id="c36" value="PoE++ switch (Cat6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#5B6B75;fontColor=#FFFFFF;strokeColor=#5B6B75;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="522" width="110" height="50" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=none;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.47000000000000003;entryDx=0;entryDy=0;" parent="1" edge="1" source="c36" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Hall 5&lt;/b&gt;&lt;br&gt;Primary PTZ + Standby PTZ&lt;br&gt;&lt;font style='font-size:11px'&gt;Matrix SATATYA PTZ5040P&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Existing RF card reader&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="620" width="230" height="95" as="geometry"/></mxCell><mxCell id="c40" value="PoE++ switch (Cat6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#5B6B75;fontColor=#FFFFFF;strokeColor=#5B6B75;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="642" width="110" height="50" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=none;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" parent="1" edge="1" source="c40" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Backup NAS (server room)&lt;/b&gt;&lt;br&gt;encrypted copies, last 14 days" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="760" width="230" height="70" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Offline encrypted copy&lt;/b&gt;&lt;br&gt;monthly, in the college safe" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#DCE3E6;fontColor=#1B2730;strokeColor=#DCE3E6;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="420" y="845" width="230" height="70" as="geometry"/></mxCell><mxCell id="c45" value="encrypted backup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c13" target="c43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="795"/></Array></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#B5452F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B5452F;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" edge="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="&lt;b&gt;Safety against corruption and misuse&lt;/b&gt;&lt;br&gt;RAID-1 mirror; encrypted backup within minutes of every change; restore tested monthly; backup key split between our office and the college; two-person approval to delete; re-enrolment must match the same face; tamper-evident audit log." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="680" y="760" width="450" height="155" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;College central system&lt;/b&gt;&lt;br&gt;owns the timetable and student records (ID, name, class, RF card)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1270" y="150" width="290" height="105" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Sends to the Edge AI&lt;/b&gt;&lt;br&gt;student list with RF card numbers;&lt;br&gt;each lecture session: subject, lecturer, hall, time, students expected (many a day)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1270" y="290" width="290" height="120" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Pulls attendance any time&lt;/b&gt;&lt;br&gt;by session ID (or date, subject, hall): present, absent, on duty, not in list" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1270" y="445" width="290" height="105" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Never receives photos, face images or templates&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#B5452F;fontColor=#FFFFFF;strokeColor=#B5452F;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1270" y="585" width="290" height="80" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Lecturers, faculty and admin&lt;/b&gt;&lt;br&gt;browser on the college LAN:&lt;br&gt;monitor, review, override within 2 days" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#FFFFFF;fontColor=#1B2730;strokeColor=#C9D3D7;align=center;spacingLeft=4;spacingRight=4;" parent="1" vertex="1"><mxGeometry x="1270" y="700" width="290" height="110" as="geometry"/></mxCell><mxCell id="c53" value="sessions +&lt;br&gt;student lists&lt;br&gt;(HTTPS API)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#0E7C86;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0E7C86;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.37;entryDx=0;entryDy=0;" parent="1" edge="1" source="c49" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="session&lt;br&gt;attendance&lt;br&gt;(pull API)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#0E7C86;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0E7C86;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.58;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c13" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="Web UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#5B6B75;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B6B75;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" parent="1" edge="1" source="c52" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="Secure VPN push&lt;br&gt;(edge dials out to our office)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;strokeColor=#F2A900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F2A900;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="435"/><mxPoint x="385" y="745"/><mxPoint x="980" y="745"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
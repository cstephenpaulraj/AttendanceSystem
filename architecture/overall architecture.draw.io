  <diagram id="overall-architecture" name="Overall architecture">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
                <mxCell id="c2" value="&lt;b&gt;AI-Driven Classroom Attendance System: Overall Architecture&lt;/b&gt;&lt;br&gt;Fixed-camera solution, 5 lecture halls of 300 seats each (from BOM_stage1_v6, Part 2: Classroom Setup Overview)" style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="Lecture Hall 1 (300 seats, 20 rows of 15): detailed view (Halls 2 to 5 are identical)" style="fontFamily=Arial;html=1;whiteSpace=wrap;rounded=0;fillColor=#FAFAFA;strokeColor=#333333;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="780" height="460" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;6 cameras&lt;/b&gt;: 8 MP, motorised zoom 2.8–12 mm, PoE, about 4 m high, one per zone of 50 seats" style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="460" height="36" as="geometry"/></mxCell>
